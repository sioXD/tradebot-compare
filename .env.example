# Kopieren nach .env und ausfuellen.  .env NIEMALS committen oder teilen!

# --- Alpaca: je Bot ein EIGENES Paper-Konto (im Alpaca-Dashboard: Kontoauswahl oben -> neues Paper-Konto) ---
# Keys findest du im Paper-Dashboard unter "API Keys". Es wird immer paper=True verwendet.
ALPACA_WSB_KEY=
ALPACA_WSB_SECRET=
ALPACA_TRUTH_KEY=
ALPACA_TRUTH_SECRET=
ALPACA_ARMSTRONG_KEY=
ALPACA_ARMSTRONG_SECRET=

# --- LLM via OpenCode Zen (OpenAI-kompatibel) ---
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=
# Modell-IDs aus der OpenCode-Konsole (https://opencode.ai/console).
# Mehrere komma-getrennt = Reihenfolge: zuerst das erste (z.B. kostenlos), bei Limit/Fehler automatisch das naechste.
# Ein Modell am Limit wird LLM_COOLDOWN_MINUTES pausiert und danach wieder bevorzugt.
LLM_MODEL=big-pickle,gpt-6-luna
LLM_COOLDOWN_MINUTES=60

# --- Reddit (OPTIONAL) ---
# Leer lassen -> WSB-Bot nutzt ApeWisdom (oeffentliche WSB-Ticker-Statistik, kein Account noetig).
# Mit offiziellem API-Zugang (Reddit vergibt neue Apps nur noch auf Antrag) -> echte Posts via PRAW.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=tradebot-compare/0.1 by u/DEIN_REDDIT_NAME

# --- Feeds (anpassbar) ---
TRUTH_FEED_URL=https://trumpstruth.org/feed
ARMSTRONG_FEED_URL=https://www.armstrongeconomics.com/feed/

# --- Gemeinsame Handelsregeln (fuer alle Bots gleich = fairer Vergleich) ---
DEFAULT_MIN_CONFIDENCE=0.65
DEFAULT_POSITION_PCT=0.10
DEFAULT_MAX_POSITIONS=8
DEFAULT_STOP_LOSS_PCT=0.08
DEFAULT_TAKE_PROFIT_PCT=0.20
DEFAULT_TRADE_CHECK_MINUTES=5

# Optional pro Bot ueberschreiben, z.B.:
# WSB_FETCH_MINUTES=15
# ARMSTRONG_MAX_HOLD_DAYS=30

# --- Passwort fuer den Webseiten-Login (nur Passwort, kein Benutzername) ---
# Derselbe Wert ist der Bearer-Token fuer die JSON-API / das Scriptable-Widget.
# Wird ausschliesslich hier gesetzt – kein Script, keine Zufallsgenerierung.
# Werte mit #, Leerzeichen oder " in einfache Anfuehrungszeichen setzen:
#   API_TOKEN='mein langes passwort'
# Keine Zeilenumbrueche, am besten nur ASCII. Mindestens 16 Zeichen empfohlen.
API_TOKEN=
